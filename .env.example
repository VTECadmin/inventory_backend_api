# Copy to .env and adjust for the environment this instance serves.
#
# There are two backend instances on the same EC2, each with ITS OWN .env:
#   dev  : dev database  + dev Cognito pool  + PORT 3000  (service inventory-api)
#   prod : prod database + prod Cognito pool + PORT 3001  (service inventory-api-prod)
# The two differ only in the values below (DB, Cognito, PORT, NODE_ENV).

# HTTP server. dev = 3000, prod = 3001 (the reverse proxy maps each hostname
# to the matching port).
PORT=3000

# Node environment. Set NODE_ENV=production on the prod instance so the startup
# config check (fail-fast on missing vars) is active. Leave unset in dev.
# NODE_ENV=production

# PostgreSQL connection (a SEPARATE database per environment).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vtec_dashboard        # prod uses its own DB name, e.g. vtec_inventory_prod
DB_USER=postgres
DB_PASSWORD=

# JWT signing secret. Only used by the local email+password login, which is
# OFF by default (see ALLOW_LOCAL_LOGIN). Still set a strong value.
JWT_SECRET=change-me

# Local login (email+password → local JWT) is dev/test-only scaffolding and is
# DISABLED unless this is "1". Leave it UNSET on dev and prod (Cognito only).
# ALLOW_LOCAL_LOGIN=1

# Cognito authentication. Must match the dashboard environment this API serves,
# or every request 401s (issuer mismatch).
#   dev  : COGNITO_USER_POOL_ID=eu-central-1_fhjuxln2B  COGNITO_CLIENT_ID=21vatrg53ktubcmaklpaust2e8
#   prod : COGNITO_USER_POOL_ID=eu-central-1_IQpfGPzmU  COGNITO_CLIENT_ID=5dotgh0v0rk80uothkdgkml2bj
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=eu-central-1_fhjuxln2B
COGNITO_CLIENT_ID=21vatrg53ktubcmaklpaust2e8

# Allowed cross-origin callers (comma-separated). Defaults to the dashboard
# (production and dev) plus the local development ports.
CORS_ORIGINS=https://internal.vtecdashboard.com,https://dev-internal.vtecdashboard.com,http://localhost:4200,http://localhost:4300
