# Copy to .env and adjust for your environment.

# HTTP server
PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vtec_dashboard
DB_USER=postgres
DB_PASSWORD=

# JWT signing secret (local login path, used for development and tests)
JWT_SECRET=change-me

# Cognito authentication. Defaults target the production user pool.
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=eu-central-1_6GUhKxiDm
COGNITO_CLIENT_ID=19hf1ddteog5peadgjvjkt2vn9

# Allowed cross-origin callers (comma-separated). Defaults to the dashboard
# (production and dev) plus the local development ports.
CORS_ORIGINS=https://internal.vtecdashboard.com,https://dev-internal.vtecdashboard.com,http://localhost:4200,http://localhost:4300
