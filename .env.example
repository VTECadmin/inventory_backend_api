# Copy to .env and adjust for your environment.

# HTTP server
PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vtec_dashboard
DB_USER=postgres
DB_PASSWORD=

# JWT signing secret (local login path, used for development and tests)
JWT_SECRET=change-me

# Cognito authentication. Must match the dashboard environment the API serves,
# or every request 401s (issuer mismatch). Values below target dev; for prod use
# COGNITO_USER_POOL_ID=eu-central-1_IQpfGPzmU and
# COGNITO_CLIENT_ID=5dotgh0v0rk80uothkdgkml2bj
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=eu-central-1_fhjuxln2B
COGNITO_CLIENT_ID=21vatrg53ktubcmaklpaust2e8

# Allowed cross-origin callers (comma-separated). Defaults to the dashboard
# (production and dev) plus the local development ports.
CORS_ORIGINS=https://internal.vtecdashboard.com,https://dev-internal.vtecdashboard.com,http://localhost:4200,http://localhost:4300
